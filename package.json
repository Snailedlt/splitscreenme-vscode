{
  "name": "splitscreenme-vscode",
  "displayName": "SplitScreen.Me / Nucleus Co-op Handler Tools",
  "description": "IntelliSense, docs, linting and packaging for Nucleus Co-op game handlers (SplitScreen.Me).",
  "version": "0.5.0",
  "publisher": "splitscreenme",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SplitScreen-Me/splitscreenme-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets",
    "Other"
  ],
  "keywords": [
    "nucleus",
    "nucleus co-op",
    "splitscreen",
    "split-screen",
    "handler"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "nucleus": "./dist/cli.js",
    "nucleus-lint": "./dist/cli.js"
  },
  "activationEvents": [
    "onLanguage:javascript"
  ],
  "contributes": {
    "mcpServerDefinitionProviders": [
      {
        "id": "nucleus",
        "label": "Nucleus Co-op handler tools"
      }
    ],
    "commands": [
      {
        "command": "splitscreenme.whatsNew",
        "title": "What's New",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.newHandler",
        "title": "New Handler…",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.tryIt",
        "title": "Try It (Simulate Each Player)",
        "category": "Nucleus",
        "icon": "$(play)"
      },
      {
        "command": "splitscreenme.tryItSet",
        "title": "Try It: Change Settings",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.tryItTestAll",
        "title": "Try It: Test All Combinations (Players, Input, Monitors)",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.fixAll",
        "title": "Fix All Auto-fixable Problems",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.formatHandler",
        "title": "Format Handler (indentation and spacing)",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.packageHandler",
        "title": "Package Handler for the Hub (.nc)",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.installHandler",
        "title": "Install Handler into Nucleus Co-op",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.browseHub",
        "title": "Browse Handlers on the Hub…",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.setupTypes",
        "title": "Set Up Type Definitions (jsconfig.json + .d.ts)",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.setupAgents",
        "title": "Set Up AI Agent Support (AGENTS.md, skill, CLI)",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.lintWorkspace",
        "title": "Lint All Handlers in Workspace",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.openDocs",
        "title": "Open Documentation…",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.linkGameFolder",
        "title": "Link the Game's Folder…",
        "category": "Nucleus"
      },
      {
        "command": "splitscreenme.unlinkGameFolder",
        "title": "Unlink the Game's Folder",
        "category": "Nucleus"
      }
    ],
    "keybindings": [
      {
        "command": "splitscreenme.formatHandler",
        "key": "shift+alt+f",
        "mac": "shift+alt+f",
        "when": "editorTextFocus && !editorReadonly && splitscreenme.isHandler"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "splitscreenme.packageHandler",
          "when": "resourceExtname == .js",
          "group": "nucleus@1"
        },
        {
          "command": "splitscreenme.installHandler",
          "when": "resourceExtname == .js && !isWeb",
          "group": "nucleus@2"
        }
      ],
      "editor/title": [
        {
          "command": "splitscreenme.tryIt",
          "when": "splitscreenme.isHandler",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "splitscreenme.tryItSet",
          "when": "false"
        },
        {
          "command": "splitscreenme.tryItTestAll",
          "when": "false"
        },
        {
          "command": "splitscreenme.installHandler",
          "when": "!isWeb"
        },
        {
          "command": "splitscreenme.setupAgents",
          "when": "!isWeb"
        }
      ]
    },
    "snippets": [
      {
        "language": "javascript",
        "path": "./snippets/nucleus.code-snippets"
      }
    ],
    "configuration": {
      "title": "SplitScreen.Me / Nucleus Co-op",
      "properties": {
        "splitscreenme.detection": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "off"
          ],
          "default": "auto",
          "enumDescriptions": [
            "JavaScript files that assign Game.GUID/GameName/ExecutableName/Play/…, or live in a \"handlers\" folder.",
            "Treat every JavaScript file as a Nucleus handler.",
            "Disable all handler features."
          ],
          "description": "Which JavaScript files are treated as Nucleus Co-op handlers."
        },
        "splitscreenme.showWhatsNew": {
          "type": "boolean",
          "default": true,
          "description": "After an update, show a short note with what's new (the full list is in Nucleus: What's New)."
        },
        "splitscreenme.lint.enable": {
          "type": "boolean",
          "default": true,
          "description": "Report problems in handlers (ES5-only syntax, unknown options, type mismatches, Hub install pitfalls, …)."
        },
        "splitscreenme.lint.compareWithHub": {
          "type": "boolean",
          "default": true,
          "description": "For a handler with a Hub.Handler.Id line, compare Game.GUID with the version published on hub.splitscreen.me (guid-changed). Downloads that version once and keeps it in the cache."
        },
        "splitscreenme.lint.packageChecks": {
          "type": "boolean",
          "default": true,
          "description": "Check the files in a handler's folder (<Name>/ next to <Name>.js) as they'd go into the .nc: names Windows can't install, files that overwrite each other, broken INI/JSON, very large files, and files the handler uses (Game.Folder + \"\\\\x\") that aren't there."
        },
        "splitscreenme.gameFolders": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "additionalProperties": {
            "type": "string"
          },
          "markdownDescription": "The game's install folder for each handler (file name → folder), set with **Nucleus: Link the Game's Folder…**. The handler is then checked against the real files (`ExecutableName`, `BinariesFolder`, the symlink and copy lists…), and those lists suggest the game's files. Only names and sizes are read; nothing leaves your PC."
        },
        "splitscreenme.lint.rules": {
          "type": "object",
          "default": {},
          "markdownDescription": "Override the severity of individual rules, e.g. `{ \"deprecated\": \"off\", \"unknown-member\": \"error\" }`. See the [rule list](https://github.com/SplitScreen-Me/splitscreenme-vscode#lint-rules).",
          "properties": {
            "syntax-error": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "es5-only": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "let-const-semantics": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "unknown-member": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "readonly-member": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "type-mismatch": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "too-late": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "value-format": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "wrong-arguments": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "missing-required": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "callback-only-global": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "callback-misuse": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "guid-changed": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "file-encoding": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "undefined-name": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "missing-builtin": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "duplicate-assignment": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "hub-install-parse": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "guid-characters": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "deprecated": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "protoinput-legacy-hooks": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "protoinput-inactive": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "protoinput-needs-hook": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "blocked-message": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            },
            "needs-option": {
              "type": "string",
              "enum": [
                "error",
                "warning",
                "info",
                "hint",
                "off"
              ]
            }
          },
          "additionalProperties": false
        },
        "splitscreenme.completion.enable": {
          "type": "boolean",
          "default": true,
          "description": "Provide completion, hover and signature help for the Nucleus API. Turned off automatically by \"Set Up Type Definitions\", since TypeScript then provides them."
        },
        "splitscreenme.nucleusPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Nucleus Co-op installation folder (contains NucleusCoop.exe and \"handlers\"). Used by \"Install Handler into Nucleus Co-op\"."
        }
      }
    },
    "breakpoints": [
      {
        "language": "javascript"
      }
    ],
    "debuggers": [
      {
        "type": "nucleus",
        "label": "Nucleus handler (simulated)",
        "languages": [
          "javascript"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The handler to step through.",
                "default": "${file}"
              },
              "players": {
                "type": "number",
                "description": "How many players Nucleus sets up (1-16).",
                "default": 2
              },
              "keyboard": {
                "description": "Who has the keyboard and mouse: a player number, \"all\" (each player their own) or \"none\".",
                "default": 1,
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "all",
                      "none"
                    ]
                  }
                ]
              },
              "resolution": {
                "type": "string",
                "description": "The monitor's size.",
                "default": "1920x1080",
                "pattern": "^\\d+x\\d+$"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause on the first statement instead of running to a breakpoint.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nucleus",
            "request": "launch",
            "name": "Step through the handler",
            "program": "${file}",
            "players": 2
          }
        ],
        "configurationSnippets": [
          {
            "label": "Nucleus: step through a handler",
            "description": "Run the handler the way Nucleus does, simulated, and pause at breakpoints",
            "body": {
              "type": "nucleus",
              "request": "launch",
              "name": "Step through the handler",
              "program": "^\"\\${file}\"",
              "players": 2,
              "keyboard": 1,
              "resolution": "1920x1080"
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "generate": "node scripts/generate-api.mjs && node scripts/generate-wm.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/build.mjs --tests && node --test dist-test/*.test.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.1.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1b1f2a",
    "theme": "dark"
  }
}
