    "breakpoints": [
      {
        "language": "javascript"
      }
    ],
    "debuggers": [
      {
        "type": "nucleus",
        "label": "Nucleus handler (simulated)",
        "languages": [
          "javascript"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The handler to step through.",
                "default": "${file}"
              },
              "players": {
                "type": "number",
                "description": "How many players Nucleus sets up (1-16).",
                "default": 2
              },
              "keyboard": {
                "description": "Who has the keyboard and mouse: a player number, \"all\" (each player their own) or \"none\".",
                "default": 1,
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "enum": [
                      "all",
                      "none"
                    ]
                  }
                ]
              },
              "resolution": {
                "type": "string",
                "description": "The monitor's size.",
                "default": "1920x1080",
                "pattern": "^\\d+x\\d+$"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Pause on the first statement instead of running to a breakpoint.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "nucleus",
            "request": "launch",
            "name": "Step through the handler",
            "program": "${file}",
            "players": 2
          }
        ],
        "configurationSnippets": [
          {
            "label": "Nucleus: step through a handler",
            "description": "Run the handler the way Nucleus does, simulated, and pause at breakpoints",
            "body": {
              "type": "nucleus",
              "request": "launch",
              "name": "Step through the handler",
              "program": "^\"\\${file}\"",
              "players": 2,
              "keyboard": 1,
              "resolution": "1920x1080"
            }
          }
        ]
      }
    ],
    "walkthroughs": [
      {
        "id": "nucleus.start",
        "title": "Make a Nucleus Co-op handler",
        "description": "From an empty file to a handler players can download from the Hub: write it, let it check itself, try it, test it in Nucleus, share it.",
        "when": "true",
        "steps": [
          {
            "id": "start",
            "title": "Start a handler",
            "description": "Start from the template, with the game's name and its .exe, or from a handler that already works for a similar game (same engine, same launcher).\n[New Handler…](command:splitscreenme.newHandler)\n[Browse the Hub…](command:splitscreenme.browseHub)\nIn an empty .js file, typing `handler` offers the whole template too.",
            "media": {
              "image": {
                "light": "media/walkthrough/vscode-hover-light.png",
                "dark": "media/walkthrough/vscode-hover-dark.png",
                "hc": "media/walkthrough/vscode-hover-dark.png",
                "hcLight": "media/walkthrough/vscode-hover-light.png"
              },
              "altText": "A handler open in VS Code, with the docs of an option shown on hover"
            },
            "completionEvents": [
              "onCommand:splitscreenme.newHandler",
              "onCommand:splitscreenme.browseHub"
            ]
          },
          {
            "id": "check",
            "title": "Let it check itself as you type",
            "description": "Problems are underlined as you type: red stops Nucleus, orange is probably wrong. Hover one for why and what to do; **Ctrl+.** offers the fix. Hover any option for its docs; suggestions know what exists where.\n[Fix All Auto-fixable Problems](command:splitscreenme.fixAll)",
            "media": {
              "image": {
                "light": "media/walkthrough/vscode-problems-light.png",
                "dark": "media/walkthrough/vscode-problems-dark.png",
                "hc": "media/walkthrough/vscode-problems-dark.png",
                "hcLight": "media/walkthrough/vscode-problems-light.png"
              },
              "altText": "Problems in a handler, each explained, with a fix offered"
            },
            "completionEvents": [
              "onCommand:splitscreenme.fixAll"
            ]
          },
          {
            "id": "tryit",
            "title": "Try it before Nucleus does",
            "description": "Try It runs `Game.Play` for each player, the way Nucleus would, and shows what each one gets: window, launch arguments, files changed. Nothing on your PC is touched.\n[Try It](command:splitscreenme.tryIt)",
            "media": {
              "image": {
                "light": "media/walkthrough/vscode-try-it-light.png",
                "dark": "media/walkthrough/vscode-try-it-dark.png",
                "hc": "media/walkthrough/vscode-try-it-dark.png",
                "hcLight": "media/walkthrough/vscode-try-it-light.png"
              },
              "altText": "The Try It panel: what each player gets"
            },
            "completionEvents": [
              "onCommand:splitscreenme.tryIt"
            ]
          },
          {
            "id": "folder",
            "title": "Link the game's folder",
            "description": "Point it at where the game is installed and the checks can see the real files: the exe's name, the folders to link or copy, the files to suggest.\n[Link the Game's Folder…](command:splitscreenme.linkGameFolder)",
            "media": {
              "markdown": "media/walkthrough/folder.md"
            },
            "completionEvents": [
              "onCommand:splitscreenme.linkGameFolder"
            ]
          },
          {
            "id": "install",
            "title": "Test it in Nucleus Co-op",
            "description": "One click installs the handler (and its folder) into Nucleus' `handlers` folder and starts Nucleus with the game selected: pick the players and press Play. Turn on the debug log when asked: if something's off, `debug-log.txt` says why.\n[Test in Nucleus Co-op](command:splitscreenme.testInNucleus)\n[Open the Debug Log](command:splitscreenme.openNucleusLog)",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onCommand:splitscreenme.testInNucleus",
              "onCommand:splitscreenme.installHandler"
            ]
          },
          {
            "id": "share",
            "title": "Share it on the Hub",
            "description": "Package makes the .nc file the Hub takes: the handler and its folder. Upload it at [hub.splitscreen.me](https://hub.splitscreen.me/).\n[Package Handler for the Hub](command:splitscreenme.packageHandler)",
            "media": {
              "markdown": "media/walkthrough/share.md"
            },
            "completionEvents": [
              "onCommand:splitscreenme.packageHandler"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "generate": "node scripts/generate-api.mjs && node scripts/generate-wm.mjs && node scripts/generate-jsbuiltins.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/build.mjs --tests && node --test dist-test/*.test.js",
    "package": "vsce package --no-dependencies",
    "standalone": "node scripts/build.mjs && sh npp-plugin/build.sh && node scripts/sea.mjs --require-plugin",
    "vscode:prepublish": "node scripts/build.mjs --production"
  },
